{
  "name": "electron-npm-installer",
  "version": "0.1.0",
  "type": "module",
  "description": "Self-update and launcher shortcuts for Electron apps distributed through npm (npm i -g / npx) — no installers, no code signing",
  "license": "MIT",
  "author": "dichev <dichev.lab@gmail.com>",
  "homepage": "https://github.com/dichev/claude-discover/tree/main/packages/electron-npm-installer#readme",
  "bugs": "https://github.com/dichev/claude-discover/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dichev/claude-discover.git",
    "directory": "packages/electron-npm-installer"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./launch-mode": {
      "types": "./types/launch-mode.d.ts",
      "default": "./src/launch-mode.js"
    }
  },
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types"
  ],
  "scripts": {
    "start": "electron example",
    "test": "vitest run"
  },
  "dependencies": {
    "latest-version": "^9.0.0",
    "semver": "^7.8.5"
  },
  "peerDependencies": {
    "electron": ">=30"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "electron",
    "npm",
    "update",
    "auto-update",
    "self-update",
    "updater",
    "shortcuts"
  ]
}
