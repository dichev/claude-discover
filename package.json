{
  "name": "claude-discover",
  "version": "1.10.11",
  "type": "module",
  "description": "Claude Discover - a desktop tool to explore local Claude Code CLI and SDK sessions on a timeline: conversations, token usage and cost, system prompts, and raw API traffic.",
  "license": "MIT",
  "author": "dichev <dichev.lab@gmail.com>",
  "repository": "github:dichev/claude-discover",
  "engines": {
    "node": ">=22"
  },
  "main": "out/main/main.js",
  "bin": {
    "claude-discover": "bin/claude-discover.mjs"
  },
  "files": [
    "out",
    "bin"
  ],
  "scripts": {
    "predev": "kill-port 5555 9333",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "test": "vitest run --reporter=tree",
    "proxy": "node bin/proxy.mjs --restart",
    "readme": "gh markdown-preview",
    "smoke:local": "npm pack && npx -y ./claude-discover-${npm_package_version}.tgz",
    "smoke:global": "npm pack && npm i -g ./claude-discover-${npm_package_version}.tgz && claude-discover",
    "prepack": "npm run build",
    "publish:patch": "npm test && npm version patch && git push --follow-tags && echo Approve once CI is green: https://www.npmjs.com/settings/g.dichev/staged-packages"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "electron": "45.0.0",
    "electron-find-overlay": "^1.0.2",
    "electron-update-from-npm": "^1.0.5",
    "electron-window-state": "^5.0.3"
  },
  "devDependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tomjs/electron-devtools-installer": "^4.0.1",
    "@uiw/react-json-view": "^2.0.0-alpha.44",
    "@vitejs/plugin-react": "^6.1.2",
    "date-fns": "^4.4.0",
    "electron-context-menu": "^5.1.0",
    "electron-vite": "^6.0.0",
    "gpt-tokenizer": "^4.1.0",
    "highlight.js": "^11.12.0",
    "kill-port": "^2.0.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.8",
    "react-tooltip": "^6.0.9",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "which": "^7.0.0",
    "write-file-atomic": "^8.0.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-code-proxy",
    "claude-code-inspect",
    "system-prompt",
    "session-browser",
    "session-explorer",
    "session-viewer",
    "session-profiler",
    "transcript-viewer",
    "token-usage",
    "token-cost",
    "cost-tracker",
    "usage-dashboard",
    "api-inspector"
  ]
}
